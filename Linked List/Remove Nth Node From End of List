class Solution {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {
        int N=0;
        ListNode* temp=head;
        while(temp){
            N++;
            temp=temp->next;
        }

        // if(N==1) return NULL; // does not require as below line cover that case
        if(n==N) return head->next; // if head itself is to be deleted, just return head->next
        temp=head;

        for(int i=0;i<N-n-1;i++){ 
            temp=temp->next;
        }
        temp->next=temp->next->next; 
        return head;
    }
};
