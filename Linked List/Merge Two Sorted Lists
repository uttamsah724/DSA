https://leetcode.com/problems/merge-two-sorted-lists/description/

class Solution {
public:
    ListNode* mergeTwoLists(ListNode* list1, ListNode* list2) {
        ListNode* dummy = new ListNode(0);
        ListNode* d = dummy;
        ListNode* p1 = list1;
        ListNode* p2 = list2;

        while(p1!=NULL && p2!=NULL){
            if(p1->val <= p2->val){
                d->next = p1;
                p1 = p1->next;
            }
            else{
                d->next = p2;
                p2 = p2->next;
            }
            d = d->next;
        }

        while(p1!=NULL){
            d->next = p1;
            p1 = p1->next;
            d = d->next;
        }

        while(p2!=NULL){
            d->next = p2;
            p2 = p2->next;
            d = d->next;
        }

        return dummy->next;
    }
};
