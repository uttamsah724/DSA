https://leetcode.com/problems/powx-n/description/

class Solution {
public:
    double myPow(double x, int n) {
        if(n==0) return 1;  //if(x==0) return 0; no need
        
        long m=abs(n);
        if(n<0){
            x=1/x;
        }

        if(n%2==0) return myPow(x*x,m/2);
        else return x*myPow(x*x,m/2);
    }
};
