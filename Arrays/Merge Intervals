class Solution {
public:
    vector<vector<int>> merge(vector<vector<int>>& intervals) {
        if(intervals.size()==1) return intervals; 
        sort(intervals.begin(),intervals.end());
        vector<vector<int>> v;
        v.push_back(intervals[0]); // using answer vector in if condition to separate the new intervals from previous one, as new interval is different
        for(int i=1;i<intervals.size();i++){
            if(v.back()[1]>=intervals[i][0]){ 
                v.back()[1]=max(intervals[i][1],v.back()[1]); //(1,5)(2,4) 
                // v.back is use to get the value of last vector input
            }
            else v.push_back(intervals[i]);
        }
        return v;
    }
};
