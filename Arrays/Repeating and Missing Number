class Solution {
  public:
    vector<int> findTwoElement(vector<int>& arr) {
        sort(arr.begin(),arr.end());
        int n=arr.size();
        vector<int> v;

        for(int i=0;i<n-1;i++){
            if(arr[i+1] == arr[i]){
                v.push_back(arr[i]);
                break;
            }
        }
        
        bool flag = false;
        for(int i=0;i<n-1;i++){
            if(arr[i+1]-arr[i] == 2){
                v.push_back(arr[i]+1);
                flag=true;
                break;
            }
        }
        
        if(flag == false){
            if(arr[0]!=1) v.push_back(1);
            if(arr[n-1]!=n) v.push_back(n);
        }

        return v;
    }
};
