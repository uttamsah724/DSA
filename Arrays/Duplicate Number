https://leetcode.com/problems/find-the-duplicate-number/

class Solution {
public:
    int findDuplicate(vector<int>& nums) {
        sort(nums.begin(),nums.end());
        int n=nums.size();
        int ans;
        
        for(int i=0;i<n-1;i++){
            if(nums[i+1] == nums[i]){
                ans = nums[i];
            }
        }
        return ans;
    }
};
