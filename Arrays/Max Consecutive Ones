class Solution {
public:
    int findMaxConsecutiveOnes(vector<int>& nums) {
        int cnt=1, max=0;
        if(nums.size()==1){
            if(nums[0]==1) return 1;
            if(nums[0]==0) return 0;
        }

        for(int i=0;i<nums.size()-1;i++){
            if(nums[i]==nums[i+1] && nums[i]==1){
                cnt++;
                if(cnt>max) max=cnt;
            }
            else if(nums[i]==1 || nums[i+1]==1) {
                cnt = 1;
                if(cnt>max) max=cnt;
            }
            else cnt=1;
        }
        
        return max;
    }
};
