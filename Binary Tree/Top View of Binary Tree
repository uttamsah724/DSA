https://www.geeksforgeeks.org/problems/top-view-of-binary-tree/1

class Solution
{
    public:
    vector<int> topView(Node *root)
    {
        vector<int> v;
        if(!root) return v;
        map<int,int> mp;
        queue<pair<Node*,int>> q;
        q.push({root,0});
        
        while(!q.empty()){
            auto temp=q.front();
            q.pop();
            if(mp.find(temp.second)==mp.end()) mp[temp.second]=temp.first->data; // sort acc to index which is temp.second
            if(temp.first->left) q.push({temp.first->left,temp.second-1});
            if(temp.first->right) q.push({temp.first->right,temp.second+1});        
        }
        for(auto i : mp) v.push_back(i.second);
        return v;
    }
};
